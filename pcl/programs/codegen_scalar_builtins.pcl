program codegen_scalar_builtins;

begin
   writeInteger(abs(-7));
   writeChar('\n');
   writeInteger(trunc(3.9));
   writeChar('\n');
   writeInteger(round(3.6));
   writeChar('\n');
   writeInteger(ord(chr(65)));
   writeChar('\n');
   writeChar(chr(ord('A') + 1));
   writeChar('\n');
   writeBoolean(fabs(-2.5) = 2.5);
   writeChar('\n');
   writeBoolean(sqrt(9.0) = 3.0);
   writeChar('\n');
   writeBoolean((pi() > 3.14) and (pi() < 3.15));
   writeChar('\n');
   writeBoolean(sin(pi() / 2.0) > 0.99);
   writeChar('\n');
   writeBoolean(cos(0.0) = 1.0);
   writeChar('\n');
   writeBoolean(tan(0.0) = 0.0);
   writeChar('\n');
   writeBoolean(arctan(0.0) = 0.0);
   writeChar('\n');
   writeBoolean(exp(0.0) = 1.0);
   writeChar('\n');
   writeBoolean(ln(1.0) = 0.0);
   writeChar('\n')
end.
