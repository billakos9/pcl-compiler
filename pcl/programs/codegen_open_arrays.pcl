program codegen_open_arrays;

var values : ^array of integer;

begin
   new [3] values;
   values^[0] := 7;
   values^[1] := values^[0] + 4;
   values^[2] := values^[1] * 3;
   writeInteger(values^[2]);
   writeChar('\n');
   dispose [] values;
   writeBoolean(values = nil);
   writeChar('\n')
end.
