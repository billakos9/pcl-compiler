type token =
    T_while
  | T_var
  | T_true
  | T_times
  | T_then
  | T_string_const of string
  | T_semicolon
  | T_rparen
  | T_return
  | T_result
  | T_real_const of float
  | T_real
  | T_rbracket
  | T_program
  | T_procedure
  | T_plus
  | T_or
  | T_of
  | T_not
  | T_nil
  | T_new
  | T_ne
  | T_mod
  | T_minus
  | T_lt
  | T_lparen
  | T_le
  | T_lbracket
  | T_label
  | T_integer
  | T_int_const of int
  | T_if
  | T_id of string
  | T_gt
  | T_goto
  | T_ge
  | T_function
  | T_forward
  | T_fdiv
  | T_false
  | T_eq
  | T_eof
  | T_end
  | T_else
  | T_dot
  | T_do
  | T_div
  | T_dispose
  | T_comma
  | T_colon
  | T_char_const of char
  | T_char
  | T_caret
  | T_boolean
  | T_begin
  | T_at
  | T_assign
  | T_array
  | T_and
val menhir_begin_marker : int
val xv_var_decl_list : (string list * Ast.typ) list
val xv_var_decl : string list * Ast.typ
val xv_typ : Ast.typ
val xv_stmt_list : Ast.stmt list
val xv_stmt : Ast.stmt
val xv_program : Ast.program
val xv_locals : Ast.local list
val xv_local : Ast.local
val xv_id_list : string list
val xv_header : Ast.header
val xv_formal_list : Ast.formal list
val xv_formal : Ast.formal
val xv_expr_list : Ast.expr list
val xv_expr : Ast.expr
val xv_call : string * Ast.expr list
val xv_body : Ast.body
val xv_block : Ast.stmt list
val menhir_end_marker : int
